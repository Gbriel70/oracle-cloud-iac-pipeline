# ============================================================================
# Terraform Values Example - NUNCA COMMITAR COM VALORES REAIS!
# Copy este arquivo para terraform.tfvars e preencha com seus valores
# ============================================================================

# OCI Credentials (obtenha do console OCI)
tenancy_ocid         = "ocid1.tenancy.oc1..aaaaaaaaaa"
user_ocid            = "ocid1.user.oc1..aaaaaaaaaa"
fingerprint          = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path     = "/home/seu-user/.oci/oci_api_key.pem"
compartment_id       = "ocid1.compartment.oc1..aaaaaaaaaa"

# SSH Key (gere com: ssh-keygen -t rsa -b 4096)
ssh_public_key_path  = "/home/seu-user/.ssh/id_rsa.pub"

# OCI Configuration
region      = "sa-saopaulo-1"  # Mude para sua região
environment = "dev"            # dev, staging ou prod
owner       = "seu-email@example.com"

# Network
vcn_cidr              = "10.0.0.0/16"
public_subnet_cidr    = "10.0.1.0/24"
private_subnet_cidr   = "10.0.2.0/24"

# Compute
kubernetes_node_count = 1                    # dev: 1, prod: 3+
enable_bastion        = true
instance_display_name = "k8s-node"

# Image (⚠️ IMPORTANTE: Always Free usa aarch64-minimal!)
image_name_pattern = "Canonical-Ubuntu-22.04-aarch64-minimal*"

# SSH Access
allowed_ssh_cidrs = ["seu-ip/32"]  # ← MUDE PARA SEU IP!
# Para descobrir seu IP: curl https://ifconfig.me

# Storage
postgresql_volume_size_gb = 50  # dev: 50, prod: 100+

# Tags
project_name = "devopsec-pipeline"
